{
  "name": "webisight",
  "version": "1.0.0",
  "private": true,
  "description": "WebISight - Website Readiness & AI Discoverability Analyzer",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" --names \"server,client\" --prefix-colors \"blue,magenta\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client run dev",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
